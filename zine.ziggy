.zine_version = "0.14.1-dev",
.supermd = .{ .headings_h2 = true },
.site = .simple(.{
    .title = "zast · Zig Abstract Syntax Tree",
    .host_url = "https://neudinger.github.io",
    .url_path_prefix = "zast-site",
    .content_dir_path = "content",
    .layouts_dir_path = "layouts",
    .assets_dir_path = "assets",
    .static_assets = [
        "fonts",
        "icons",
        "licenses",
        "catalog.js",
        "examples.js",
        "highlight.js",
        "api-examples.js",
        "rotation.js",
        "tree.js",
        "ast-leaf.webp",
        "ast-forest.webp",
        "ast-bark.webp",
        "ast-roots.webp",
    ],
}),
